{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/migrate-target.schema.json",
  "title": "Java and Spring Boot Migration Target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "target",
    "allowPrerelease",
    "coverage",
    "policy",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/versions"
    },
    "target": {
      "$ref": "#/$defs/versions"
    },
    "allowPrerelease": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumLine",
        "minimumBranch"
      ],
      "properties": {
        "minimumLine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumBranch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireOfficialCompatibilityEvidence",
        "requireSpringCloudCompatibility",
        "requireSpringCloudAzureCompatibility",
        "requireDependencyBomAlignment",
        "stopOnUnsupportedCompatibility"
      ],
      "properties": {
        "requireOfficialCompatibilityEvidence": {
          "type": "boolean"
        },
        "requireSpringCloudCompatibility": {
          "type": "boolean"
        },
        "requireSpringCloudAzureCompatibility": {
          "type": "boolean"
        },
        "requireDependencyBomAlignment": {
          "type": "boolean"
        },
        "stopOnUnsupportedCompatibility": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java",
        "springBoot"
      ],
      "properties": {
        "java": {
          "type": "string",
          "minLength": 1
        },
        "springBoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
